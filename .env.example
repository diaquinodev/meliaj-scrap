# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Mercado Livre - aplicativo em https://developers.mercadolivre.com.br
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_ACCESS_TOKEN=

# ImgBB - hospedagem das fotos enviadas ao anúncio (https://api.imgbb.com)
IMGBB_API_KEY=

# UpSeller - conta usada pelo robô de publicação (RPA)
UPSELLER_EMAIL=
UPSELLER_PASSWORD=
UPSELLER_LOJA=

# Case LLMOps: exporte estas variáveis no shell (não há carregamento automático).
SERVICE_API_TOKEN=
LLM_MODE=demo
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=2048
LLM_MAX_CONCURRENCY=4
# Preços por milhão de tokens, conferidos para sua conta/modelo. Vazio = desconhecido.
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=
